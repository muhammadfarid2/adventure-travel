# ==========================================
# ADVENTURE TRAVEL INDONESIA - ENV CONFIG
# ==========================================

# Port Server Backend Node.js (Railway otomatis menyediakan PORT)
PORT=5000

# Environment Mode
NODE_ENV=production

# Database Connection (Railway PostgreSQL)
# Format Internal Railway (Di dalam project Railway yang sama):
# DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
# Format Public Railway (Jika diakses dari luar):
# DATABASE_URL=postgresql://postgres:PASSWORD@proxy.rlwy.net:PORT/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_travel

# JWT Secret Key untuk Autentikasi Admin & User
JWT_SECRET=adventure_travel_secret_key_2026_id

# Frontend URL (CORS configuration pada Backend Railway)
# Isi dengan domain frontend Vercel Anda, misal: https://adventure-travel.vercel.app (atau * untuk mengizinkan semua origin)
FRONTEND_URL=*
